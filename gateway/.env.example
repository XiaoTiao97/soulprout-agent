# ============================================================
# Soulprout Gateway 部署配置（CLI / headless 可选）
#
# 推荐使用：bash gateway/run.sh
# 登录 Soulprout 账号请在 CLI 中用邮箱验证码完成，无需手动填写 token。
# 平台凭证也可在此预设，启动时会自动读取。
# ============================================================

# ── Agent 服务地址（可选，默认云服务）────────────────────────
# AGENT_URL=https://www.soulprout.com

# ── 邮箱（可选，CLI 登录时可自动读取，免去重复输入）──────────
# AGENT_EMAIL=you@example.com

# ── 飞书（可选，CLI 可扫码；也可在此填写 App 凭证）────────────
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=secret_xxx
# FEISHU_DOMAIN=feishu

# ── 企业微信 AI Bot（可选，CLI 可扫码；也可在此填写）──────────
# WECOM_BOT_ID=bot_xxx
# WECOM_SECRET=secret_xxx
# WECOM_WEBSOCKET_URL=wss://openws.work.weixin.qq.com

# ── 小爱音箱（CLI 可交互填写；也可在此预设）──────────────────
# XIAOMI_USER_ID=你的小米ID
# XIAOMI_PASSWORD=密码
# XIAOMI_PASS_TOKEN=可选，与密码二选一
# XIAOMI_DID=设备名称

# ── 管理 Web 服务（仅 Web 模式，CLI 模式不启用）──────────────
# GATEWAY_WEB_HOST=0.0.0.0
# GATEWAY_WEB_PORT=8082
